# StudyScape Environment Configuration
# -------------------------------------------------------------
# Recommended Persistent Authentication: Supabase Auth
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon public key below:
# -------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: If these variables are not provided, StudyScape automatically
# uses an offline-first cryptographically secure native vault
# powered by Web Crypto API (PBKDF2 with 100,000 rounds, SHA-256,
# unique random 16-byte salts, and IndexedDB). Plaintext passwords
# are never stored in localStorage under any circumstances.
